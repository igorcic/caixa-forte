{
  "name": "caixa-forte",
  "productName": "Caixa Forte",
  "version": "1.0.0",
  "description": "Finanças pessoais: salário CLT líquido, dívidas, parcelas e relatório Excel",
  "main": "main.js",
  "author": "Igor Bastos",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.app.caixaforte",
    "productName": "Caixa Forte",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Caixa Forte"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.finance"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "pg": "^8.13.1"
  }
}